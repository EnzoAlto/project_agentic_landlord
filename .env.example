# Copy this file to .env and fill in private values locally.
TELEGRAM_BOT_TOKEN=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Local Ollama or authenticated Modal GPU inference.
AI_BACKEND=ollama
MODAL_QWEN_APP=landlord-qwen
DATABASE_PATH=data/landlord.db
PAYMENT_PROOF_DIR=data/payment_proofs

# Dashboard storage. Keep local for laptop experimentation.
STORAGE_BACKEND=local
MODAL_WORKER_APP=landlord-db-worker-test
MODAL_DATASET=production
# In Streamlit Cloud use Secrets for MODAL_TOKEN_ID and MODAL_TOKEN_SECRET.

# The deployed modal_mcp.py explicitly uses public, read-only prototype access.
# Local construction defaults to OAuth unless explicitly set to none.
# For future OAuth: attach a landlord-mcp Secret and configure these settings.
# The provider API audience must equal MCP_PUBLIC_URL; require landlord:read.
MCP_AUTH_MODE=none
MCP_PUBLIC_URL=
MCP_OAUTH_ISSUER_URL=
MCP_OAUTH_JWKS_URL=
# Prototype: every valid sign-in may read the existing MODAL_DATASET above.
# Still requires an OAuth access token for this server with landlord:read scope.
MCP_ALLOW_ANY_SIGNED_IN=true
# Optional account allowlist when MCP_ALLOW_ANY_SIGNED_IN is false.
# Comma-separated provider account subject IDs, not email addresses.
MCP_ADMIN_SUBJECTS=
